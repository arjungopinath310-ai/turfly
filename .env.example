# --- Core ---
DATABASE_URL="postgresql://turfly:turfly@localhost:5432/turfly?schema=public"
# Automated database tests use their own schema so they never touch live data (npm run test:integration)
TEST_DATABASE_URL="postgresql://turfly:turfly@localhost:5432/turfly?schema=test"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
APP_URL="http://localhost:3000"

# Comma-separated +91 numbers that become ADMIN on first sign-in
ADMIN_PHONES="+919999999999"

# Public demo without SMS/Razorpay: shows OTP on screen (never for admins / real owners) and
# simulated payments, with a "Demo version" banner. Set to "false" once MSG91 + Razorpay are connected.
DEMO_MODE="true"

# --- OTP / SMS (MSG91). Leave blank in dev: OTP is printed to server log and shown on screen ---
# Each SMS needs its own DLT-registered template; texts and steps: docs/sms-templates.txt
OTP_DEV_ECHO="true"
# Optional fixed demo sign-in code (e.g. "12345678") while SMS isn't set up; DEMO_OTP_ADMINS="true" also allows admin numbers
DEMO_OTP=""
DEMO_OTP_ADMINS=""
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_TPL_BOOKING_CONFIRMED=""
MSG91_TPL_REMINDER=""
MSG91_TPL_BALANCE_PENDING=""

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Razorpay. Leave blank to use the mock gateway in development ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
ALLOW_MOCK_PAYMENTS="false"

# --- WhatsApp Cloud API (optional) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Email via Resend (optional) ---
RESEND_API_KEY=""
EMAIL_FROM="Turfly <bookings@example.com>"

# Secret for /api/cron/tick (call every minute from a scheduler)
CRON_SECRET="replace-me"

# --- Business identity (shown on Terms, Privacy, Refunds, Contact pages; required by Razorpay & Google Play) ---
BUSINESS_NAME=""
BUSINESS_ADDRESS=""
BUSINESS_CITY="Manjeri, Kerala"
SUPPORT_EMAIL=""
SUPPORT_PHONE=""
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_OFFICER_EMAIL=""

# --- Push notifications (Firebase Cloud Messaging). base64 of the Firebase service-account JSON ---
FCM_SERVICE_ACCOUNT_JSON=""

# --- Abuse protection: maximum OTP SMS per hour across the whole platform ---
OTP_GLOBAL_PER_HOUR="500"

# --- Seeding: "false" in production creates only cities + the admin (no fictional demo turfs/users) ---
SEED_DEMO="true"

# --- Docker production stack only (docker-compose.prod.yml) ---
POSTGRES_PASSWORD=""
CLOUDFLARE_TUNNEL_TOKEN=""

# Turf photo storage (docs/SCALING.md). disk = this server's uploads folder (one server only).
# s3 = shared bucket for several servers: Cloudflare R2, AWS S3, Backblaze B2 or MinIO.
STORAGE_DRIVER="disk"
UPLOAD_DIR=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public bucket / CDN address for photos (optional; otherwise served through /api/uploads)
S3_PUBLIC_URL=""
