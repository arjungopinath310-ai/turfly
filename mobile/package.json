{
  "name": "turfly-mobile",
  "version": "1.1.4",
  "private": true,
  "description": "Turfly Android app: a native Capacitor shell around the Turfly web app, with push notifications, UPI hand-off, downloads and offline screen",
  "scripts": {
    "sync": "cap sync android",
    "icons": "python -I ../scripts/make-icons.py android/app/src/main/res",
    "build:debug": "node scripts/build.mjs debug",
    "build:release": "node scripts/build.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/push-notifications": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
