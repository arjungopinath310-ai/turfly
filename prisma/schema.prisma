// Turfly data model. All money is integer paise. All timestamps are UTC.
// The double-booking guarantee lives in migration 0002 (EXCLUDE constraint on Occupancy).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & auth ─────────────────────────────

enum Role {
  PLAYER
  OWNER
  ADMIN
}

model User {
  id                    String    @id @default(cuid())
  phone                 String?   @unique // E.164, +91XXXXXXXXXX
  email                 String?   @unique
  name                  String?
  image                 String?
  role                  Role      @default(PLAYER)
  preferredPosition     String?
  shareContactWithTeams Boolean   @default(false) // consent to show phone to teammates
  isSuspended           Boolean   @default(false)
  referralCode          String?   @unique
  referredById          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ownedTurfs      Turf[]             @relation("TurfOwner")
  bookings        Booking[]          @relation("BookingOrganiser")
  teams           Team[]             @relation("TeamOwner")
  memberships     TeamMember[]
  payments        Payment[]
  reviews         Review[]
  notifications   Notification[]
  playerPosts     PlayerPost[]
  postRequests    PlayerPostRequest[]
  claims          TurfClaim[]        @relation("Claimant")
  disputes        Dispute[]          @relation("DisputeRaiser")
  matchPlayers    MatchPlayer[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ───────────────────────────── Geography ─────────────────────────────

model City {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  district String?
  state    String
  lat      Float
  lng      Float
  pincodes String[]
  isActive Boolean @default(true)
  turfs    Turf[]
  posts    PlayerPost[]
}

// ───────────────────────────── Turfs ─────────────────────────────

enum TurfStatus {
  UNCLAIMED       // added by admin from public info; owner can claim
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityMode {
  LIVE            // managed on platform; bookable online
  OWNER_REPORTED  // owner updates manually; informational
  NONE            // no availability data (e.g. unclaimed)
}

model Turf {
  id                       String           @id @default(cuid())
  slug                     String           @unique
  name                     String
  description              String?
  ownerId                  String?
  owner                    User?            @relation("TurfOwner", fields: [ownerId], references: [id])
  status                   TurfStatus       @default(DRAFT)
  rejectionReason          String?
  availabilityMode         AvailabilityMode @default(NONE)
  availabilityUpdatedAt    DateTime?
  cityId                   String
  city                     City             @relation(fields: [cityId], references: [id])
  addressLine              String
  locality                 String?
  pincode                  String
  lat                      Float
  lng                      Float
  phone                    String?
  whatsapp                 String?
  email                    String?
  photos                   String[]
  amenities                String[]
  slotStepMinutes          Int              @default(30)
  allowedDurations         Int[]            @default([60, 90, 120])
  minNoticeMinutes         Int              @default(30)
  maxAdvanceDays           Int              @default(30)
  fullOnlinePaymentEnabled Boolean          @default(false)
  cancellationPolicy       Json?            // null → platform default
  commissionPercent        Float?           // null → platform default
  isDemo                   Boolean          @default(false)
  isFeatured               Boolean          @default(false)
  ratingAvg                Float            @default(0)
  ratingCount              Int              @default(0)
  sourceNote               String?          // where public info came from (unclaimed listings)
  claimToken               String?          @unique
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  hours        OperatingHours[]
  units        ResourceUnit[]
  configs      PitchConfig[]
  bookings     Booking[]
  blocks       SlotBlock[]
  reviews      Review[]
  claims       TurfClaim[]
  offers       Offer[]
  ledger       LedgerEntry[]
  posts        PlayerPost[]
  tournaments  Tournament[]

  @@index([cityId, status])
}

model OperatingHours {
  id          String  @id @default(cuid())
  turfId      String
  turf        Turf    @relation(fields: [turfId], references: [id], onDelete: Cascade)
  weekday     Int     // 0 = Sunday … 6 = Saturday (IST)
  isClosed    Boolean @default(false)
  openMinute  Int     // minutes from 00:00 IST
  closeMinute Int     // may exceed 1440 (closes after midnight), max 1800

  @@unique([turfId, weekday])
}

/// An atomic, exclusively-allocatable resource: a physical area ("Half A") or a virtual lock.
model ResourceUnit {
  id        String              @id @default(cuid())
  turfId    String
  turf      Turf                @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name      String
  isVirtual Boolean             @default(false)
  sortOrder Int                 @default(0)
  configs   PitchConfigUnit[]
  occupancy Occupancy[]
}

/// What a customer books ("Full 7-a-side", "5-a-side Pitch A"). Consumes one or more units.
model PitchConfig {
  id                String            @id @default(cuid())
  turfId            String
  turf              Turf              @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name              String
  playersPerSide    Int               // 5, 6, 7, 11 …
  basePricePerHour  Int               // paise
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)
  units             PitchConfigUnit[]
  pricingRules      PricingRule[]
  bookings          Booking[]
  blocks            SlotBlock[]
}

model PitchConfigUnit {
  configId String
  unitId   String
  config   PitchConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  unit     ResourceUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([configId, unitId])
}

/// Peak / off-peak pricing. First matching rule (by priority desc) wins; else basePricePerHour.
model PricingRule {
  id           String      @id @default(cuid())
  configId     String
  config       PitchConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  label        String      // "Peak", "Weekend evening"
  weekdays     Int[]       // empty = every day
  startMinute  Int
  endMinute    Int
  pricePerHour Int         // paise
  priority     Int         @default(0)
}

// ───────────────────────────── Bookings & allocation ─────────────────────────────

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  WALK_IN
  PHONE
}

model Booking {
  id                  String        @id @default(cuid())
  code                String        @unique // human booking ID, e.g. TF-7KQ2MX
  turfId              String
  turf                Turf          @relation(fields: [turfId], references: [id])
  configId            String
  config              PitchConfig   @relation(fields: [configId], references: [id])
  userId              String?
  user                User?         @relation("BookingOrganiser", fields: [userId], references: [id])
  source              BookingSource @default(ONLINE)
  status              BookingStatus @default(HELD)
  startAt             DateTime
  endAt               DateTime
  durationMinutes     Int
  // money (paise)
  totalPrice          Int           // venue price before discount
  discount            Int           @default(0)
  advanceAmount       Int           // part of the venue price paid online
  platformFee         Int           @default(0) // shown separately, on top
  onlineAmount        Int           // advanceAmount (+ rest if full payment) + platformFee
  balanceDue          Int           // payable at venue
  payFullOnline       Boolean       @default(false)
  balanceCollectedAt  DateTime?
  balanceCollectedBy  String?
  offerId             String?
  offer               Offer?        @relation(fields: [offerId], references: [id])
  policySnapshot      Json          // cancellation policy at time of booking
  holdExpiresAt       DateTime?
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  cancelledBy         String?
  cancelReason        String?
  rescheduledFromId   String?
  // team / customer
  teamId              String?
  team                Team?         @relation(fields: [teamId], references: [id])
  teamName            String?       // per-match override
  customerName        String?       // walk-in / phone bookings
  customerPhone       String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  occupancy     Occupancy[]
  payments      Payment[]
  roster        MatchPlayer[]
  review        Review?
  jobs          NotificationJob[]
  posts         PlayerPost[]
  disputes      Dispute[]
  ledger        LedgerEntry[]
  result        MatchResult?

  @@index([turfId, startAt])
  @@index([userId, startAt])
  @@index([status, holdExpiresAt])
}

model SlotBlock {
  id          String       @id @default(cuid())
  turfId      String
  turf        Turf         @relation(fields: [turfId], references: [id], onDelete: Cascade)
  configId    String?      // null → whole turf (all units)
  config      PitchConfig? @relation(fields: [configId], references: [id])
  startAt     DateTime
  endAt       DateTime
  reason      String       // MAINTENANCE | PRIVATE_EVENT | HOLIDAY | OTHER
  note        String?
  createdById String
  createdAt   DateTime     @default(now())
  occupancy   Occupancy[]
}

/// One row per (unit, time range) a booking or block consumes.
/// DB constraint `occupancy_no_overlap` forbids two non-released rows on the same unit overlapping in time.
model Occupancy {
  id        String       @id @default(cuid())
  unitId    String
  unit      ResourceUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  blockId   String?
  block     SlotBlock?   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  released  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([unitId, startAt, endAt])
  @@index([bookingId])
}

// ───────────────────────────── Payments & finance ─────────────────────────────

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  provider          String        // "razorpay" | "mock"
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  purpose           String        @default("ADVANCE") // ADVANCE | FULL | SPLIT_SHARE
  status            PaymentStatus @default(CREATED)
  method            String?       // upi | card | netbanking | wallet
  clientVerifiedAt  DateTime?     // browser handler signature check (informational only)
  capturedAt        DateTime?
  failureReason     String?
  refundedAmount    Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refunds           Refund[]
  ledger            LedgerEntry[]

  @@index([bookingId])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  amount           Int
  status           String   @default("PENDING") // PENDING | PROCESSED | FAILED
  providerRefundId String?  @unique
  reason           String
  initiatedById    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String    @unique // x-razorpay-event-id → idempotency
  type           String
  payload        Json
  signatureValid Boolean
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
}

/// Transparent settlement ledger. Positive = owed to owner; negative = deducted / paid out.
model LedgerEntry {
  id        String   @id @default(cuid())
  turfId    String
  turf      Turf     @relation(fields: [turfId], references: [id])
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  type      String   // ADVANCE_COLLECTED | COMMISSION | REFUND | PAYOUT
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([turfId, createdAt])
}

model Offer {
  id               String    @id @default(cuid())
  code             String    @unique
  title            String
  kind             String    // FIRST_BOOKING | PROMO | REPEAT | REFERRAL
  turfId           String?   // null → platform-wide
  turf             Turf?     @relation(fields: [turfId], references: [id])
  discountType     String    // PERCENT | FLAT
  value            Int       // percent, or paise
  maxDiscountPaise Int?
  minBookings      Int?      // REPEAT: min completed bookings
  usageLimit       Int?
  usedCount        Int       @default(0)
  validFrom        DateTime?
  validTo          DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  bookings         Booking[]
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Teams ─────────────────────────────

model Team {
  id             String       @id @default(cuid())
  name           String
  logoUrl        String?      // data URL (≤256px) or https URL
  playersPerSide Int
  ownerId        String
  owner          User         @relation("TeamOwner", fields: [ownerId], references: [id])
  inviteToken    String       @unique
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        TeamMember[]
  bookings       Booking[]
  history        TeamEvent[]
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

model TeamMember {
  id           String       @id @default(cuid())
  teamId       String
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  name         String
  phone        String?      // private: visible to team owner only (unless member consents)
  email        String?
  position     String?
  jerseyNumber Int?
  photoUrl     String?
  isCaptain    Boolean      @default(false)
  status       MemberStatus @default(INVITED)
  createdAt    DateTime     @default(now())

  matchSlots MatchPlayer[]

  @@index([teamId])
}

model TeamEvent {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type      String   // CREATED | RENAMED | MEMBER_ADDED | MEMBER_REMOVED | CAPTAIN_CHANGED | MEMBER_JOINED
  detail    String
  createdAt DateTime @default(now())
}

enum MatchPlayerStatus {
  CONFIRMED
  PENDING
  DECLINED
}

model MatchPlayer {
  id           String            @id @default(cuid())
  bookingId    String
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  teamMemberId String?
  teamMember   TeamMember?       @relation(fields: [teamMemberId], references: [id])
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  name         String
  status       MatchPlayerStatus @default(PENDING)
  isCaptain    Boolean           @default(false)
  isSubstitute Boolean           @default(false)
  goals        Int               @default(0)
  assists      Int               @default(0)

  @@index([bookingId])
}

model MatchResult {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ourScore         Int
  opponentName     String?
  opponentScore    Int
  playerOfMatchId  String?
  createdAt        DateTime @default(now())
}

// ───────────────────────────── Community ─────────────────────────────

model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique // one review per verified booking
  booking      Booking  @relation(fields: [bookingId], references: [id])
  turfId       String
  turf         Turf     @relation(fields: [turfId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  turfQuality  Int
  cleanliness  Int
  lighting     Int
  parking      Int
  overall      Int
  comment      String?
  createdAt    DateTime @default(now())

  @@index([turfId])
}

model PlayerPost {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  cityId         String
  city           City                @relation(fields: [cityId], references: [id])
  turfId         String?
  turf           Turf?               @relation(fields: [turfId], references: [id])
  bookingId      String?
  booking        Booking?            @relation(fields: [bookingId], references: [id])
  playersNeeded  Int
  playersPerSide Int
  startAt        DateTime
  skillLevel     String?
  sharePerPlayer Int?                // paise, informational (pay organiser at venue)
  note           String?
  status         String              @default("OPEN") // OPEN | FILLED | CLOSED
  createdAt      DateTime            @default(now())
  requests       PlayerPostRequest[]

  @@index([cityId, status, startAt])
}

model PlayerPostRequest {
  id        String     @id @default(cuid())
  postId    String
  post      PlayerPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  message   String?
  status    String     @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
}

model TurfClaim {
  id           String    @id @default(cuid())
  turfId       String
  turf         Turf      @relation(fields: [turfId], references: [id])
  userId       String
  user         User      @relation("Claimant", fields: [userId], references: [id])
  evidence     String    // e.g. GST / trade licence number, role
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
}

model Dispute {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id])
  raisedById   String
  raisedBy     User      @relation("DisputeRaiser", fields: [raisedById], references: [id])
  reason       String
  status       String    @default("OPEN") // OPEN | RESOLVED | REJECTED
  resolution   String?
  refundAmount Int?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model NotificationJob {
  id        String    @id @default(cuid())
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  channel   String    // IN_APP | SMS | WHATSAPP | EMAIL
  template  String    // BOOKING_CONFIRMED | REMINDER_24H | REMINDER_2H | BALANCE_PENDING | BOOKING_CANCELLED
  sendAt    DateTime
  status    String    @default("PENDING") // PENDING | SENT | FAILED | CANCELLED | SKIPPED
  attempts  Int       @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([bookingId, template, channel])
  @@index([status, sendAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ───────────────────────────── Tournaments (phase 2 UI) ─────────────────────────────

model Tournament {
  id             String   @id @default(cuid())
  turfId         String?
  turf           Turf?    @relation(fields: [turfId], references: [id])
  organiserId    String
  name           String
  format         String   // KNOCKOUT | LEAGUE
  playersPerSide Int
  entryFeePaise  Int      @default(0)
  startsOn       DateTime
  status         String   @default("DRAFT") // DRAFT | REGISTRATION | LIVE | DONE
  createdAt      DateTime @default(now())
  teams          TournamentTeam[]
  fixtures       Fixture[]
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  paid         Boolean    @default(false)
  points       Int        @default(0)

  @@unique([tournamentId, teamId])
}

model Fixture {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  homeTeamId   String?
  awayTeamId   String?
  homeScore    Int?
  awayScore    Int?
  bookingId    String?
  startAt      DateTime?
}
