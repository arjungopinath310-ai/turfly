// Turfly data model. All money is integer paise. All timestamps are UTC.
// The double-booking guarantee lives in migration 0002 (EXCLUDE constraint on Occupancy).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & auth ─────────────────────────────

enum Role {
  PLAYER
  OWNER
  ADMIN
}

model User {
  id                    String    @id @default(cuid())
  phone                 String?   @unique // E.164, +91XXXXXXXXXX
  email                 String?   @unique
  name                  String?
  image                 String?
  role                  Role      @default(PLAYER)
  preferredPosition     String?
  shareContactWithTeams Boolean   @default(false) // consent to show phone to teammates
  isSuspended           Boolean   @default(false)
  deletedAt             DateTime? // account deleted by the user: personal data erased, financial records kept
  termsAcceptedAt       DateTime? // when the person accepted the terms (sign-up or first sign-in)
  referralCode          String?   @unique
  referredById          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ownedTurfs    Turf[]              @relation("TurfOwner")
  bookings      Booking[]           @relation("BookingOrganiser")
  teams         Team[]              @relation("TeamOwner")
  memberships   TeamMember[]
  payments      Payment[]
  reviews       Review[]
  notifications Notification[]
  playerPosts   PlayerPost[]
  postRequests  PlayerPostRequest[]
  gameMessages  PlayerPostMessage[]
  coinEntries   CoinEntry[]
  claims        TurfClaim[]         @relation("Claimant")
  disputes      Dispute[]           @relation("DisputeRaiser")
  matchPlayers  MatchPlayer[]
  conversations Conversation[]      @relation("ConversationPlayer")
  messagesSent  Message[]
  devices       DeviceToken[]
  splitShares   SplitShare[]        @relation("SplitSharePayer")
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  ip         String? // requester IP, for SMS-pumping protection
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Push-notification token of an installed app (Firebase Cloud Messaging).
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // "android" | "ios" | "web"
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────── Geography ─────────────────────────────

model City {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  district String?
  state    String
  lat      Float
  lng      Float
  pincodes String[]
  isActive Boolean      @default(true)
  turfs    Turf[]
  posts    PlayerPost[]
}

// ───────────────────────────── Turfs ─────────────────────────────

enum TurfStatus {
  UNCLAIMED // added by admin from public info; owner can claim
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityMode {
  LIVE // managed on platform; bookable online
  OWNER_REPORTED // owner updates manually; informational
  NONE // no availability data (e.g. unclaimed)
}

model Turf {
  id                       String           @id @default(cuid())
  slug                     String           @unique
  name                     String
  description              String?
  ownerId                  String?
  owner                    User?            @relation("TurfOwner", fields: [ownerId], references: [id])
  status                   TurfStatus       @default(DRAFT)
  rejectionReason          String?
  availabilityMode         AvailabilityMode @default(NONE)
  availabilityUpdatedAt    DateTime?
  cityId                   String
  city                     City             @relation(fields: [cityId], references: [id])
  addressLine              String
  locality                 String?
  pincode                  String
  lat                      Float
  lng                      Float
  phone                    String?
  whatsapp                 String?
  email                    String?
  photos                   String[]
  amenities                String[]
  slotStepMinutes          Int              @default(60)
  allowedDurations         Int[]            @default([60, 120])
  minNoticeMinutes         Int              @default(30)
  maxAdvanceDays           Int              @default(30)
  fullOnlinePaymentEnabled Boolean          @default(false)
  cancellationPolicy       Json? // null → platform default
  commissionPercent        Float? // null → platform default
  isDemo                   Boolean          @default(false)
  /// A private sample copy of the demo turf for one signed-in person (demo mode): hidden from players and other owners.
  isSandbox                Boolean          @default(false)
  isFeatured               Boolean          @default(false)
  ratingAvg                Float            @default(0)
  ratingCount              Int              @default(0)
  sourceNote               String? // where public info came from (unclaimed listings)
  // Price players report for a turf that doesn't manage bookings here (no pitch prices of its own).
  // Shown as "reported", never used for charging. Set by an admin; cleared once the owner sets real prices.
  reportedPriceFrom        Int? // paise per hour, lowest reported
  reportedPriceNote        String? // e.g. "₹1,000 after 6 PM; source: called the turf"
  reportedPriceAt          DateTime?
  claimToken               String?          @unique
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  hours         OperatingHours[]
  units         ResourceUnit[]
  configs       PitchConfig[]
  bookings      Booking[]
  blocks        SlotBlock[]
  reviews       Review[]
  claims        TurfClaim[]
  offers        Offer[]
  ledger        LedgerEntry[]
  posts         PlayerPost[]
  tournaments   Tournament[]
  conversations Conversation[]

  @@index([cityId, status])
  @@index([status, availabilityMode])
  @@index([lat, lng])
  @@index([isSandbox, ownerId])
}

model OperatingHours {
  id          String  @id @default(cuid())
  turfId      String
  turf        Turf    @relation(fields: [turfId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday … 6 = Saturday (IST)
  isClosed    Boolean @default(false)
  openMinute  Int // minutes from 00:00 IST
  closeMinute Int // may exceed 1440 (closes after midnight), max 1800

  @@unique([turfId, weekday])
}

/// An atomic, exclusively-allocatable resource: a physical area ("Half A") or a virtual lock.
model ResourceUnit {
  id        String            @id @default(cuid())
  turfId    String
  turf      Turf              @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name      String
  isVirtual Boolean           @default(false)
  sortOrder Int               @default(0)
  configs   PitchConfigUnit[]
  occupancy Occupancy[]
}

/// What a customer books ("Full 7-a-side", "5-a-side Pitch A"). Consumes one or more units.
model PitchConfig {
  id               String            @id @default(cuid())
  turfId           String
  turf             Turf              @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name             String
  playersPerSide   Int // 5, 6, 7, 11 …
  basePricePerHour Int // paise
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  units            PitchConfigUnit[]
  pricingRules     PricingRule[]
  bookings         Booking[]
  blocks           SlotBlock[]
}

model PitchConfigUnit {
  configId String
  unitId   String
  config   PitchConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  unit     ResourceUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([configId, unitId])
}

/// Peak / off-peak pricing. First matching rule (by priority desc) wins; else basePricePerHour.
model PricingRule {
  id           String      @id @default(cuid())
  configId     String
  config       PitchConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  label        String // "Peak", "Weekend evening"
  weekdays     Int[] // empty = every day
  startMinute  Int
  endMinute    Int
  pricePerHour Int // paise
  priority     Int         @default(0)
}

// ───────────────────────────── Bookings & allocation ─────────────────────────────

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  WALK_IN
  PHONE
}

model Booking {
  id                 String        @id @default(cuid())
  code               String        @unique // human booking ID, e.g. TF-7KQ2MX
  turfId             String
  turf               Turf          @relation(fields: [turfId], references: [id])
  configId           String
  config             PitchConfig   @relation(fields: [configId], references: [id])
  userId             String?
  user               User?         @relation("BookingOrganiser", fields: [userId], references: [id])
  source             BookingSource @default(ONLINE)
  status             BookingStatus @default(HELD)
  startAt            DateTime
  endAt              DateTime
  durationMinutes    Int
  // money (paise)
  totalPrice         Int // venue price before discount
  coinsUsed          Int           @default(0) // Turf coins spent on this booking's online advance
  coinsValue         Int           @default(0) // their value in paise (Turfly pays it to the turf)
  discount           Int           @default(0)
  advanceAmount      Int // part of the venue price paid online
  platformFee        Int           @default(0) // shown separately, on top
  onlineAmount       Int // advanceAmount (+ rest if full payment) + platformFee
  balanceDue         Int // payable at venue
  splitCollected     Int           @default(0) // friends' shares paid online (already deducted from balanceDue)
  payFullOnline      Boolean       @default(false)
  balanceCollectedAt DateTime?
  balanceCollectedBy String?
  offerId            String?
  offer              Offer?        @relation(fields: [offerId], references: [id])
  policySnapshot     Json // cancellation policy at time of booking
  holdExpiresAt      DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancelReason       String?
  rescheduledFromId  String?
  // team / customer
  teamId             String?
  team               Team?         @relation(fields: [teamId], references: [id])
  teamName           String? // per-match override
  customerName       String? // walk-in / phone bookings
  customerPhone      String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  occupancy     Occupancy[]
  payments      Payment[]
  roster        MatchPlayer[]
  review        Review?
  jobs          NotificationJob[]
  posts         PlayerPost[]
  coinEntries   CoinEntry[]
  disputes      Dispute[]
  ledger        LedgerEntry[]
  result        MatchResult?
  conversations Conversation[]
  split         SplitPlan?

  @@index([turfId, startAt])
  @@index([userId, startAt])
  @@index([status, holdExpiresAt])
  @@index([status, endAt])
}

model SlotBlock {
  id          String       @id @default(cuid())
  turfId      String
  turf        Turf         @relation(fields: [turfId], references: [id], onDelete: Cascade)
  configId    String? // null → whole turf (all units)
  config      PitchConfig? @relation(fields: [configId], references: [id])
  startAt     DateTime
  endAt       DateTime
  reason      String // MAINTENANCE | PRIVATE_EVENT | HOLIDAY | OTHER
  note        String?
  createdById String
  createdAt   DateTime     @default(now())
  occupancy   Occupancy[]
}

/// One row per (unit, time range) a booking or block consumes.
/// DB constraint `occupancy_no_overlap` forbids two non-released rows on the same unit overlapping in time.
model Occupancy {
  id        String       @id @default(cuid())
  unitId    String
  unit      ResourceUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  blockId   String?
  block     SlotBlock?   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  released  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([unitId, startAt, endAt])
  @@index([bookingId])
}

// ───────────────────────────── Payments & finance ─────────────────────────────

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  provider          String // "razorpay" | "mock"
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  purpose           String        @default("ADVANCE") // ADVANCE | FULL | SPLIT_SHARE
  splitShareId      String? // set for purpose SPLIT_SHARE
  splitShare        SplitShare?   @relation(fields: [splitShareId], references: [id])
  status            PaymentStatus @default(CREATED)
  method            String? // upi | card | netbanking | wallet
  clientVerifiedAt  DateTime? // browser handler signature check (informational only)
  capturedAt        DateTime?
  failureReason     String?
  refundedAmount    Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refunds           Refund[]
  ledger            LedgerEntry[]

  @@index([bookingId])
}

/// Organiser splits the venue price into equal shares; friends pay theirs online via one link.
/// The organiser's own share (the remainder) is covered by their advance + the balance at the venue.
model SplitPlan {
  id          String       @id @default(cuid())
  bookingId   String       @unique
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  token       String       @unique // share link /split/<token>
  players     Int // total people sharing, organiser included
  shareAmount Int // paise per friend
  createdAt   DateTime     @default(now())
  cancelledAt DateTime?
  shares      SplitShare[]
}

model SplitShare {
  id             String    @id @default(cuid())
  planId         String
  plan           SplitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  seq            Int
  status         String    @default("OPEN") // OPEN | PAID | REFUNDED
  claimedById    String? // payer currently in checkout; the claim expires so abandoned checkouts free the share
  claimExpiresAt DateTime?
  paidById       String?
  paidBy         User?     @relation("SplitSharePayer", fields: [paidById], references: [id])
  paidPaymentId  String?   @unique
  paidAt         DateTime?
  payments       Payment[]

  @@unique([planId, seq])
  @@unique([planId, paidById]) // one share per person
  @@index([planId, status])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  amount           Int
  status           String   @default("PENDING") // PENDING | PROCESSED | FAILED
  providerRefundId String?  @unique
  reason           String
  initiatedById    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String    @unique // x-razorpay-event-id → idempotency
  type           String
  payload        Json
  signatureValid Boolean
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
}

/// Transparent settlement ledger. Positive = owed to owner; negative = deducted / paid out.
model LedgerEntry {
  id        String   @id @default(cuid())
  turfId    String
  turf      Turf     @relation(fields: [turfId], references: [id])
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  type      String // ADVANCE_COLLECTED | SPLIT_COLLECTED | COMMISSION | REFUND | PAYOUT
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([turfId, createdAt])
}

model Offer {
  id               String    @id @default(cuid())
  code             String    @unique
  title            String
  kind             String // FIRST_BOOKING | PROMO | REPEAT | REFERRAL
  turfId           String? // null → platform-wide
  turf             Turf?     @relation(fields: [turfId], references: [id])
  discountType     String // PERCENT | FLAT
  value            Int // percent, or paise
  maxDiscountPaise Int?
  minBookings      Int? // REPEAT: min completed bookings
  usageLimit       Int?
  usedCount        Int       @default(0)
  validFrom        DateTime?
  validTo          DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  bookings         Booking[]
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Teams ─────────────────────────────

model Team {
  id             String       @id @default(cuid())
  name           String
  logoUrl        String? // data URL (≤256px) or https URL
  playersPerSide Int
  ownerId        String
  owner          User         @relation("TeamOwner", fields: [ownerId], references: [id])
  inviteToken    String       @unique
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        TeamMember[]
  bookings       Booking[]
  history        TeamEvent[]
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

model TeamMember {
  id           String       @id @default(cuid())
  teamId       String
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  name         String
  phone        String? // private: visible to team owner only (unless member consents)
  email        String?
  position     String?
  jerseyNumber Int?
  photoUrl     String?
  isCaptain    Boolean      @default(false)
  status       MemberStatus @default(INVITED)
  createdAt    DateTime     @default(now())

  matchSlots MatchPlayer[]

  @@index([teamId])
}

model TeamEvent {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type      String // CREATED | RENAMED | MEMBER_ADDED | MEMBER_REMOVED | CAPTAIN_CHANGED | MEMBER_JOINED
  detail    String
  createdAt DateTime @default(now())
}

enum MatchPlayerStatus {
  CONFIRMED
  PENDING
  DECLINED
}

model MatchPlayer {
  id           String            @id @default(cuid())
  bookingId    String
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  teamMemberId String?
  teamMember   TeamMember?       @relation(fields: [teamMemberId], references: [id])
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  name         String
  status       MatchPlayerStatus @default(PENDING)
  isCaptain    Boolean           @default(false)
  isSubstitute Boolean           @default(false)
  goals        Int               @default(0)
  assists      Int               @default(0)

  @@index([bookingId])
}

model MatchResult {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ourScore        Int
  opponentName    String?
  opponentScore   Int
  playerOfMatchId String?
  createdAt       DateTime @default(now())
}

// ───────────────────────────── Community ─────────────────────────────

model Review {
  id          String   @id @default(cuid())
  bookingId   String   @unique // one review per verified booking
  booking     Booking  @relation(fields: [bookingId], references: [id])
  turfId      String
  turf        Turf     @relation(fields: [turfId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  turfQuality Int
  cleanliness Int
  lighting    Int
  parking     Int
  overall     Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([turfId])
}

model PlayerPost {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  cityId         String
  city           City                @relation(fields: [cityId], references: [id])
  turfId         String?
  turf           Turf?               @relation(fields: [turfId], references: [id])
  bookingId      String?
  booking        Booking?            @relation(fields: [bookingId], references: [id])
  playersNeeded  Int
  playersPerSide Int
  startAt        DateTime
  skillLevel     String?
  sharePerPlayer Int? // paise, informational (pay organiser at venue)
  note           String?
  /// DRAFT: listed while booking, waits for the payment · OPEN: others can ask to join · FILLED · CLOSED.
  /// At most one listing per booking that isn't CLOSED (partial unique index in migration 0008).
  status         String              @default("OPEN") // DRAFT | OPEN | FILLED | CLOSED
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  requests       PlayerPostRequest[]

  @@index([cityId, status, startAt])
  @@index([status, startAt])
  @@index([turfId, status, startAt])
  @@index([bookingId])
}

model PlayerPostRequest {
  id            String              @id @default(cuid())
  postId        String
  post          PlayerPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  message       String?
  status        String              @default("PENDING") // PENDING | ACCEPTED | DECLINED | WITHDRAWN
  createdAt     DateTime            @default(now())
  /// Last chat message in this request's thread, for sorting the organiser's list.
  lastMessageAt DateTime?
  messages      PlayerPostMessage[]

  @@unique([postId, userId])
  @@index([userId, status])
}

/// Chat between a game's organiser and one player who asked to join. Only those two can read it.
model PlayerPostMessage {
  id        String            @id @default(cuid())
  requestId String
  request   PlayerPostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User              @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime          @default(now())

  @@index([requestId, createdAt])
  @@index([senderId, createdAt])
}

model TurfClaim {
  id           String    @id @default(cuid())
  turfId       String
  turf         Turf      @relation(fields: [turfId], references: [id])
  userId       String
  user         User      @relation("Claimant", fields: [userId], references: [id])
  evidence     String // e.g. GST / trade licence number, role
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
}

model Dispute {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id])
  raisedById   String
  raisedBy     User      @relation("DisputeRaiser", fields: [raisedById], references: [id])
  reason       String
  status       String    @default("OPEN") // OPEN | RESOLVED | REJECTED
  resolution   String?
  refundAmount Int?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
}

// ───────────────────────────── Chat (player ↔ turf) ─────────────────────────────

/// One thread per (turf, player). The turf's current owner answers on behalf of the turf.
/// Phone numbers are never exposed through chat; people only see names.
model Conversation {
  id               String    @id @default(cuid())
  turfId           String
  turf             Turf      @relation(fields: [turfId], references: [id])
  playerId         String
  player           User      @relation("ConversationPlayer", fields: [playerId], references: [id])
  bookingId        String? // booking the chat was started from (context only)
  booking          Booking?  @relation(fields: [bookingId], references: [id])
  lastMessageAt    DateTime  @default(now())
  lastMessageText  String?
  lastSenderId     String?
  playerLastReadAt DateTime  @default(now())
  ownerLastReadAt  DateTime  @default(now())
  createdAt        DateTime  @default(now())
  messages         Message[]

  @@unique([turfId, playerId])
  @@index([playerId, lastMessageAt])
  @@index([turfId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt]) // unread counts in the top bar on every page
  @@index([userId, createdAt])
}

model NotificationJob {
  id        String    @id @default(cuid())
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  channel   String // IN_APP | SMS | WHATSAPP | EMAIL
  template  String // BOOKING_CONFIRMED | REMINDER_24H | REMINDER_2H | BALANCE_PENDING | BOOKING_CANCELLED
  sendAt    DateTime
  status    String    @default("PENDING") // PENDING | SENT | FAILED | CANCELLED | SKIPPED
  attempts  Int       @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([bookingId, template, channel])
  @@index([status, sendAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ───────────────────────────── Tournaments (phase 2 UI) ─────────────────────────────

model Tournament {
  id             String           @id @default(cuid())
  turfId         String?
  turf           Turf?            @relation(fields: [turfId], references: [id])
  organiserId    String
  name           String
  format         String // KNOCKOUT | LEAGUE
  playersPerSide Int
  entryFeePaise  Int              @default(0)
  startsOn       DateTime
  status         String           @default("DRAFT") // DRAFT | REGISTRATION | LIVE | DONE
  createdAt      DateTime         @default(now())
  teams          TournamentTeam[]
  fixtures       Fixture[]
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  paid         Boolean    @default(false)
  points       Int        @default(0)

  @@unique([tournamentId, teamId])
}

model Fixture {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  homeTeamId   String?
  awayTeamId   String?
  homeScore    Int?
  awayScore    Int?
  bookingId    String?
  startAt      DateTime?
}

/// Turf coins: a player's balance is the sum of their entries. 1 coin = coinValuePaise (₹1 by default).
/// Earned on played online bookings, spent on a booking's online advance; no cash value, not transferable.
model CoinEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int // coins: + earned or returned, - spent
  kind      String // EARN_BOOKING | REDEEM | RETURN | ADJUST
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  note      String?
  createdAt DateTime @default(now())

  @@unique([bookingId, kind])
  @@index([userId, createdAt])
}
